{
  "name": "sindihoje-desktop",
  "productName": "SindiHoje",
  "version": "1.15.0",
  "description": "SindiHoje para Windows",
  "main": "main.js",
  "private": true,
  "author": "SindiHoje",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "publicar": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.sindihoje.desktop",
    "productName": "SindiHoje",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SindiHoje",
      "language": "1046",
      "artifactName": "SindiHoje-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "omenageado-git",
        "repo": "SindiHoje-desktop",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omenageado-git/SindiHoje-desktop.git"
  }
}

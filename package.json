{
  "name": "sindihoje-desktop",
  "productName": "SindiHoje",
  "version": "1.15.0",
  "description": "SindiHoje para Windows",
  "main": "main.js",
  "private": true,
  "author": "SindiHoje",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "publicar": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.sindihoje.desktop",
    "productName": "SindiHoje",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SindiHoje",
      "language": "1046",
      "artifactName": "SindiHoje-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "omenageado-git",
        "repo": "SindiHoje-desktop",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omenageado-git/SindiHoje-desktop.git"
  }
}
